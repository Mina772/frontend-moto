# Same-origin default: a reverse proxy in front of the app forwards /api to the backend.
# Set an absolute URL only when the app and the API live on different origins (then the
# backend needs CORS_ORIGINS=<this app origin> and COOKIE_SAMESITE=none).
VITE_API_URL=/api

# Dev-server proxy target for /api, /socket.io and /uploads.
VITE_API_PROXY=http://localhost:4000

# Socket.IO origin. Empty = same origin as the page.
VITE_SOCKET_URL=

# Public origin of THIS app — invoice QR codes point at <VITE_PUBLIC_URL>/v/:invoiceNumber.
VITE_PUBLIC_URL=
